# Host DAC execution identity (must be a unique, dedicated unprivileged UID:GID on your host)
APP_UID=
APP_GID=

# Image release tag
GATUS_VERSION='latest'

# Host network binding (defines host-side interface and port, not container internals)
# Default: 127.0.0.1 (Loopback only - secure by default, access via SSH tunnel)
# For WireGuard VPN: set to your host's WireGuard IP (e.g. 10.x.x.x)
# CAUTION: NEVER set to 0.0.0.0 unless protected by an upstream firewall/auth
HOST_BIND_IP='127.0.0.1'

# Unique unreserved host port from private dynamic range to eliminate port collisions
HOST_PORT='54080'

# Application logging level (INFO, WARN, ERROR, DEBUG)
GATUS_LOG_LEVEL='WARN'
