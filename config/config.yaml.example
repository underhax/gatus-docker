# Documentation: https://gatus.io/docs

storage:
  type: sqlite
  path: /data/data.db
  caching: true
  maximum-number-of-results: 8640
  maximum-number-of-events: 100

web:
  port: 8080

alerting:
  ntfy:
    url: "${GATUS_NTFY_URL}"
    token: "${GATUS_NTFY_TOKEN}"
    topic: "${GATUS_NTFY_TOPIC}"
    priority: 3

